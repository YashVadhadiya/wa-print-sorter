{
  "server": {
    "port": 4545,
    "host": "0.0.0.0",
    "ssl": false,
    "sslCert": "",
    "sslKey": ""
  },
  "whatsapp": {
    "enabled": true,
    "autoReconnect": true,
    "reconnectInterval": 30000,
    "sessionPath": "./data/session",
    "qrTimeout": 60000
  },
  "downloads": {
    "basePath": "./data/downloads",
    "tempPath": "./data/temp",
    "maxRetries": 3,
    "retryDelay": 5000,
    "autoDownload": true,
    "allowedExtensions": [
      ".pdf", ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".tiff",
      ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
      ".cdr", ".psd", ".ai", ".eps", ".svg",
      ".zip", ".rar", ".7z", ".tar", ".gz",
      ".mp4", ".avi", ".mkv", ".mov", ".wmv",
      ".mp3", ".wav", ".ogg", ".flac", ".aac",
      ".txt", ".rtf", ".csv", ".json", ".xml",
      ".html", ".htm", ".css", ".js", ".ts",
      ".exe", ".msi", ".dmg", ".iso"
    ],
    "maxFileSize": 1073741824,
    "blacklistedExtensions": [".exe", ".msi", ".bat", ".cmd", ".vbs", ".scr"]
  },
  "storage": {
    "type": "json",
    "backupEnabled": true,
    "backupInterval": 86400000,
    "backupPath": "./data/backups"
  },
  "logging": {
    "level": "info",
    "maxFiles": 30,
    "maxSize": 10485760,
    "path": "./data/logs"
  },
  "auth": {
    "enabled": true,
    "token": "",
    "tokenExpiry": 86400000
  },
  "notifications": {
    "desktop": true,
    "sound": true,
    "dashboard": true
  },
  "printing": {
    "enabled": false,
    "defaultPrinter": "",
    "timeout": 30000
  },
  "plugins": {
    "enabled": true,
    "path": "./plugins"
  }
}
